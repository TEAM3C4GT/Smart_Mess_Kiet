{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "smart-mess-backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install",
      "bindings": [
        {
          "type": "service",
          "service": "ai-service",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ]
    },
    "ai-service": {
      "root": "backend/ai-service",
      "framework": "fastapi"
    },
    "smart-mess-frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "smart-mess-backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "smart-mess-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "smart-mess-frontend"
      }
    }
  ]
}
